CADENCE_IMAGE=ghcr.io/YOUR-LOWERCASE-GITHUB-NAME/cadence:main
# Absolute path on the NAS, not on your PC. Verify it in UGOS.
CADENCE_SECRETS_DIR=/replace/with/private/nas/path
DISCORD_GUILD_ID=
DISCORD_TEXT_CHANNEL_ID=
# Optional Discord user ID for joining that user when playback starts.
CADENCE_AUTO_JOIN_USER_ID=
